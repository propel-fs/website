---
import Layout from "../layouts/Layout.astro";
import { url } from "../data/site";
---

<Layout title="Page not found">
  <section class="bg-fog">
    <div class="mx-auto max-w-page px-5 py-28 text-center sm:px-8 sm:py-36">
      <p class="eyebrow">Error 404</p>
      <h1 class="display mt-4 text-[40px] sm:text-[52px]">This page did not reconcile</h1>
      <p class="mx-auto mt-5 max-w-md text-[17px] leading-relaxed text-slate">
        The page you were after does not exist. Everything else does.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={url("/")} class="pill pill-filled">Back to the homepage</a>
        <a href={url("/demo")} class="pill pill-ghost">Schedule a demo</a>
      </div>
    </div>
  </section>
</Layout>
