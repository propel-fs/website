---
import LogoMark from "./LogoMark.astro";
import { nav, site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-hairline bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} home`}>
      <LogoMark class="h-7 w-7" />
      <span class="display text-[19px] tracking-tight">{site.name}</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-small px-3 py-2 text-[14.5px] font-medium transition-colors",
              isActive(item.href)
                ? "bg-accent text-primary"
                : "text-slate hover:bg-accent hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/demo" class="pill pill-filled ml-auto text-[14.5px] md:ml-2">Schedule a demo</a>

    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-small border border-hairline text-slate [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
          <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-card border border-hairline bg-paper p-2 shadow-pop">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block rounded-small px-3 py-2.5 text-[15px] font-medium text-slate hover:bg-accent hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>
