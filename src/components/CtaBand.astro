---
import { url } from "../data/site";
interface Props {
  title?: string;
  body?: string;
}

const {
  title = "See it run on your own client files",
  body = "Bring one client's month, messy files and all. We will reconcile it live and show you the exceptions, the findings and the pack that comes out the other side.",
} = Astro.props;
---

<section class="bg-ink">
  <div class="mx-auto max-w-page px-5 py-20 sm:px-8 sm:py-24">
    <div class="grid-bg rounded-elevated border border-white/10 px-6 py-14 text-center sm:px-14">
      <p class="eyebrow text-white/45">Schedule a demo</p>
      <h2 class="display mx-auto mt-4 max-w-2xl text-[32px] text-white sm:text-[42px]">{title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-[16.5px] leading-relaxed text-white/65">{body}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={url("/demo")} class="pill pill-filled w-full sm:w-auto">Schedule a demo</a>
        <a href={url("/platform")} class="pill pill-invert w-full sm:w-auto">See how it works</a>
      </div>
      <p class="mt-6 text-[13px] text-white/40">Thirty minutes. No slide deck.</p>
    </div>
  </div>
</section>
