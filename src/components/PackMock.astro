---
const rows = [
  ["Net revenue", "2,324,900", "", true],
  ["Food and packaging", "(727,700)", "31.3%", false],
  ["Labour", "(618,400)", "26.6%", false],
  ["Commission and delivery fees", "(241,900)", "10.4%", false],
  ["Card processing", "(26,000)", "1.1%", false],
  ["Other operating costs", "(495,600)", "21.3%", false],
  ["EBITDA", "215,300", "9.3%", true],
];
---

<div class="surface overflow-hidden shadow-lift">
  <div class="flex flex-wrap items-center gap-3 border-b border-hairline px-5 py-4">
    <div>
      <p class="text-[15px] font-semibold tracking-[-0.015em]">Monthly Management Pack</p>
      <p class="text-[12px] text-slate">Dallah Coffee Roasters · July 2026</p>
    </div>
    <span class="statechip chip-live ml-auto">Your branding</span>
  </div>

  <div class="px-5 py-4">
    <div class="flex items-baseline gap-2.5">
      <span class="font-mono text-[11px] text-ash">02</span>
      <h3 class="text-[14px] font-semibold">Profit and loss</h3>
      <span class="ml-auto text-[11.5px] text-ash">AED · net of VAT</span>
    </div>

    <table class="mt-3 w-full text-[13px]">
      <tbody>
        {
          rows.map(([label, value, pct, strong]) => (
            <tr class="border-b border-hairline last:border-0">
              <td class:list={["py-2 pr-3", strong && "font-semibold"]}>{label}</td>
              <td class:list={["tabular py-2 text-right", strong ? "font-semibold" : "text-slate"]}>
                {value}
              </td>
              <td class="tabular w-14 py-2 text-right text-[12px] text-ash">{pct}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="flex flex-wrap items-center gap-2 border-t border-hairline bg-fog px-5 py-3">
    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 3v11m0 0 4-4m-4 4-4-4M4 17h12"></path>
    </svg>
    <span class="text-[12.5px] text-slate">Click any figure to walk it down to the transaction behind it</span>
  </div>
</div>
